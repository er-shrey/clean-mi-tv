<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings switch: a green track with the knob at the end when on (the row is activated), glass with the
     knob at the start when off. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#FF34C759" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:gravity="end|center_vertical" android:width="20dp" android:height="20dp" android:right="3dp">
                <shape android:shape="oval">
                    <solid android:color="#FFFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#33FFFFFF" />
                    <stroke android:width="1dp" android:color="#40FFFFFF" />
                    <corners android:radius="13dp" />
                </shape>
            </item>
            <item android:gravity="start|center_vertical" android:width="20dp" android:height="20dp" android:left="3dp">
                <shape android:shape="oval">
                    <solid android:color="#E6FFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
