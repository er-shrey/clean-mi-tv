<?xml version="1.0" encoding="utf-8"?>
<!-- Launcher settings backdrop: Home's deep night blue, with a violet glow top left and a teal one bottom right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF141A2A" android:endColor="#FF06080C" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="70%p" android:centerX="0.1" android:centerY="0.05"
                android:startColor="#405B4BD6" android:endColor="#005B4BD6" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:type="radial" android:gradientRadius="60%p" android:centerX="0.95" android:centerY="1"
                android:startColor="#3314B8A6" android:endColor="#0014B8A6" />
        </shape>
    </item>
</layer-list>
